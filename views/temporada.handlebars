<div class="container-fluid">
  <div class="row align-items-center">
    <div class="col-8 text-center">
      <h5 class="text-center">Reporte de Temporada</h5>
    </div>
  </div>
  <div class="row align-items-center">
    <div class="col-8">
      <div class="row justify-content-center">
        <div class="col-6">
          <table
            class="table table-sm table-hover table-bordered table-striped"
            style="font-size: small; white-space:nowrap;overflow-x:auto;"
          >
            <thead>
              <tr>
                <th class="text-center">Mov</th>
                <th class="text-center">Total</th>
                <th class="text-center">Fecha</th>
                <th class="text-center">Descripcion_Detallada</th>
                <th class="text-center">Imp_Final</th>
              </tr>
            </thead>
            <tbody>
              {{#each data}}
                <tr>
                  <td align="right">{{this.Mov}}</td>
                  <td align="right">{{this.Total}}</td>
                  <td>{{this.Fecha}}</td>
                  <td>{{this.Descripcion_Detallada}}</td>
                  <td align="right">{{this.Imp_Final}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="row align-items-center">
    <div class="col-lg-8 col-xs-8 justify-content-center">
      <a
        href="./temporada/descargar/{{archivo}}"
        class="btn btn-success mt-2 ml-4"
      >Descargar CSV</a>
    </div>
  </div>
</div>