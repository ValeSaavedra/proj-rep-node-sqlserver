<div class="container-fluid">
  <div class="row align-items-center">
    <div class="col-8 text-center">
      <h5 class="text-center">Reporte de Historial de Pagos</h5>
      {{#if long}}{{else}}
        <span class="text-danger"><b>No hay datos para la consulta</b></span>
      {{/if}}
    </div>
  </div>
  {{#if long}}
    <div class="row align-items-center">
      <div class="col-8">
        <div class="row">
          <div class="col-6">
            <table
              class="table table-hover table-bordered table-striped"
              style="font-size: small;white-space:nowrap;overflow-x:auto;"
            >
              <thead class="text-center">
                <tr>
                  <th>Socio</th>
                  <th>Destinatario</th>
                  <th>Id Producto</th>
                  <th>Descripción</th>
                  <th>Fecha</th>
                  <th>Fecha Venc</th>
                  <th>Id Trans Mov</th>
                  <th>Id Trans</th>
                  <th>Imp Rec</th>
                  <th>Imp Item</th>
                  <th>Recibo</th>
                  <th>Fecha Mov</th>
                  <th>Id Cajero</th>
                  <th>Id Caja</th>
                  <th>Id Empleado</th>
                  <th>Empleado</th>
                  <th>Id Suc</th>
                  <th>Id Tipo Cbte</th>
                  <th>Nro Cbte</th>
                  <th>Valor</th>
                  <th>Referente</th>
                </tr>
              </thead>
              <tbody>
                {{#each socio}}
                  <tr>
                    <td>{{this.Socio}}</td>
                    <td>{{this.Destinatario}}</td>
                    <td>{{this.Id_Producto}}</td>
                    <td>{{this.Descripcion_Producto}}</td>
                    <td>{{this.Fecha}}</td>
                    <td>{{this.Fecha_Venc}}</td>
                    <td>{{this.Id_Trans_Mov}}</td>
                    <td>{{this.Id_Trans}}</td>
                    <td>{{this.Imp_Rec}}</td>
                    <td>{{this.Imp_Item}}</td>
                    <td>{{this.Recibo}}</td>
                    <td>{{this.Fecha_Mov}}</td>
                    <td>{{this.Id_Cajero}}</td>
                    <td>{{this.Id_Caja}}</td>
                    <td>{{this.Id_Empleado}}</td>
                    <td>{{this.Empleado}}</td>
                    <td>{{this.Id_Sucursal}}</td>
                    <td>{{this.Id_Tipo_Cbte}}</td>
                    <td>{{this.Comprobante_Nro}}</td>
                    <td>{{this.Valor}}</td>
                    <td>{{this.Referente}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  {{/if}}
  <div class="container-fluid">
    <div class="row align-items-center d-flex">
      <div class="col-lg-8 col-xs-12 justify-content-center text-center">
        <a href="/reportes/pagos" class="btn btn-success mt-2 ml-4">Nueva
          Consulta</a>
      </div>
    </div>
  </div>
</div>