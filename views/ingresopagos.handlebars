<div class="container-fuild">
  <h3 class="text-center text-dark mt-2">Reporte de Historial de Pagos</h3>
  <div class="row justify-content-center align-items-center">
    <div class="col-lg-5 col-xs-9 bg-dark py-5 m-2">
      <form id="formPagos" action="/reportes/pagos" method="post">
        <div class="row justify-content-center">
          <div class="col-lg-5 col-xs-12">
            <div class="form-group">
              <label for="dato" class="text-white">Ingrese NRO SOCIO o DNI</label>
              <input
                type="text"
                id="dato"
                name="dato"
                class="form-control"
                autofocus
              />
            </div>
            <button
              type="submit"
              class="btn btn-block btn-info"
              id="boton"
              onclick="deshabilitar()"
            >Enviar</button>
          </div>
        </div>
      </form>
      <button
        class="btn btn-primary"
        type="button"
        disabled
        style="display: none;"
        id="spinnerCarga"
      >
        <span
          class="spinner-border spinner-border-sm"
          role="status"
          aria-hidden="true"
        ></span>
        Este proceso puede demorar, aguarde por favor...
      </button>
    </div>
  </div>
</div>
<script>
  const deshabilitar = () => { document.getElementById("boton").disabled = true
  document.getElementById("spinnerCarga").style.display="block"
  document.getElementById("formPagos").submit() }
</script>