<div class="container-fluid">
  <div class="row align-items-center">
    <div class="col-8 text-center">
      <h5 class="text-center">Depuración de Reportes</h5>
      {{#if long}}{{else}}
        <span class="text-danger"><b>No hay archivos para depurar</b></span>
      {{/if}}
    </div>
  </div>
  {{#if long}}
    <form id="formulario" method="post" action="/reportes/depura">
      <div class="row align-items-center">
        <div class="col-8">
          <div class="row">
            <div class="col-6">
              <table
                class="table table-hover table-bordered table-striped"
                style="font-size: small;white-space:nowrap;overflow-x:auto;"
              >
                <thead class="text-center">
                  <tr>
                    <th>Nombre del Archivo</th>
                    <th>Cantidad</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each data}}
                    <tr>
                      <td>{{this.archivo}} </td>
                      <td>{{this.cantidad}}</td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      <button type="submit" class="btn btn-success" id="boton">
        Confirma Depuración
      </button>
    </form>
  {{/if}}
</div>